{
  "name": "mac-agent-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "QQ-connected macOS agent gateway powered by Codex app-server, Better Auth, and Peekaboo, with a model-provider bridge seam.",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "tsx src/main.ts",
    "start": "node dist/src/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "doctor": "node scripts/doctor.mjs",
    "config:inventory": "tsx scripts/config-inventory.ts",
    "config:inventory:check": "tsx scripts/config-inventory.ts --check",
    "config:inventory:write": "tsx scripts/config-inventory.ts --write",
    "config:validate": "tsx scripts/config-federation.ts validate",
    "config:show": "tsx scripts/config-federation.ts show",
    "config:effective": "tsx scripts/config-federation.ts json",
    "config:effective:write": "tsx scripts/config-federation.ts write",
    "config:native": "tsx scripts/config-native.ts show",
    "config:native:json": "tsx scripts/config-native.ts json",
    "config:native:check": "tsx scripts/config-native.ts check",
    "config:native:write": "tsx scripts/config-native.ts write",
    "config:diagnostics": "tsx scripts/config-diagnostics.ts show",
    "config:diagnostics:json": "tsx scripts/config-diagnostics.ts json",
    "config:diagnostics:check": "tsx scripts/config-diagnostics.ts check",
    "config:diagnostics:write": "tsx scripts/config-diagnostics.ts write",
    "config:cutover:check": "tsx scripts/config-diagnostics.ts cutover",
    "config:explain": "tsx scripts/config-diagnostics.ts explain",
    "config:codex-shadow": "tsx scripts/codex-config-shadow.ts show",
    "config:codex-shadow:json": "tsx scripts/codex-config-shadow.ts json",
    "config:codex-shadow:check": "tsx scripts/codex-config-shadow.ts check",
    "config:codex-cutover": "tsx scripts/codex-config-cutover.ts show",
    "config:codex-cutover:json": "tsx scripts/codex-config-cutover.ts json",
    "config:codex-cutover:check": "tsx scripts/codex-config-cutover.ts check",
    "storage:doctor": "tsx scripts/storage-doctor.ts",
    "storage:probe": "tsx scripts/storage-probe.ts",
    "bootstrap:validate": "node scripts/validate-bootstrap.mjs",
    "codex:schema": "bash scripts/generate-codex-schema.sh",
    "codex:probe": "tsx scripts/codex-probe.ts",
    "deepseek:probe": "tsx scripts/deepseek-probe.ts",
    "bridge:start": "tsx scripts/responses-bridge.ts",
    "bridge:probe": "tsx scripts/responses-bridge-probe.ts",
    "codex:deepseek:probe": "tsx scripts/codex-deepseek-probe.ts",
    "codex:deepseek:web-search:probe": "tsx scripts/codex-deepseek-web-search-probe.ts",
    "codex:compat:capture": "tsx scripts/codex-deepseek-web-search-probe.ts --capture-compat",
    "codex:compat:check": "tsx scripts/codex-compat-check.ts",
    "bridge:faults:check": "vitest run tests/bridge-retry.test.ts tests/deepseek-stream.test.ts tests/bridge-concurrency.test.ts tests/responses-bridge-faults.test.ts",
    "searxng:prepare": "tsx scripts/searxng.ts prepare",
    "searxng:up": "tsx scripts/searxng.ts up",
    "searxng:down": "tsx scripts/searxng.ts down",
    "searxng:status": "tsx scripts/searxng.ts status",
    "searxng:health": "tsx scripts/searxng.ts health",
    "searxng:doctor": "tsx scripts/searxng-doctor.ts",
    "mac:smoke": "bash scripts/mac-smoke.sh",
    "dev:watch": "tsx watch src/main.ts",
    "qq:sdk:check": "tsx scripts/qq-sdk-check.ts",
    "qq:private:probe": "tsx scripts/qq-private-probe.ts",
    "qq:full-chain:probe": "tsx scripts/qq-full-chain-probe.ts",
    "qq:reconnect:probe": "tsx scripts/qq-reconnect-probe.ts",
    "service:doctor": "tsx scripts/service.ts doctor",
    "service:install": "tsx scripts/service.ts install",
    "service:start": "tsx scripts/service.ts start",
    "service:status": "tsx scripts/service.ts status",
    "service:restart": "tsx scripts/service.ts restart",
    "service:stop": "tsx scripts/service.ts stop",
    "service:logs": "tsx scripts/service.ts logs",
    "service:recovery:probe": "tsx scripts/service.ts recovery-probe",
    "service:uninstall": "tsx scripts/service.ts uninstall",
    "config:mcp-adoption": "tsx scripts/mcp-registry-adoption.ts show",
    "config:mcp-adoption:json": "tsx scripts/mcp-registry-adoption.ts json",
    "config:mcp-adoption:check": "tsx scripts/mcp-registry-adoption.ts check"
  },
  "dependencies": {
    "@tencent-connect/qqbot-nodejs": "1.0.4",
    "better-auth": "^1.6.25",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.10.0",
    "pino": "^9.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
