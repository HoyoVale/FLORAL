NODE_ENV=development
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info
DATA_DIR=./data
DATABASE_PATH=./data/floral.sqlite
# The main process owns this atomic single-instance lock.
FLORAL_INSTANCE_LOCK_PATH=./data/floral.lock
# LaunchAgent readiness and crash-recovery diagnostics are written here.
FLORAL_SERVICE_STATE_PATH=./data/service-state.json
# foreground | launchagent. The generated plist sets launchagent automatically.
FLORAL_SERVICE_MODE=foreground
# Mac-local remote execution ceiling. Default/recommended: auto.
# Set full only on the trusted Mac when the paired owner should be allowed to use /mode full.
# This value is removed from the Codex child-process environment.
FLORAL_REMOTE_MODE_CEILING=auto
# Optional Mac-local parent directory. Direct child directories become selectable projects.
# Example: /Volumes/WORK_1TB/AgentWorkspace
FLORAL_WORKSPACE_ROOT=
# Mock transport may auto-claim the local owner identity.
MOCK_TRUST_OWNER=true

# Primary chat entry. Leave blank to preserve legacy QQ_MODE behavior.
# mock | qq | feishu
CHAT_TRANSPORT=

# Legacy QQ adapter mode: mock | real
QQ_MODE=mock
CODEX_MODE=mock
MACOS_MODE=mock
AUTH_MODE=local

# QQ Open Platform
QQBOT_APP_ID=
QQBOT_APP_SECRET=
# SDK session resume state stays local and is ignored by Git.
QQBOT_SESSION_DIR=./data/qq-session
QQBOT_STARTUP_TIMEOUT_MS=30000
# Passive reply targets are deliberately short-lived and bounded.
QQBOT_REPLY_TARGET_TTL_MS=240000
QQBOT_REPLY_TARGET_CACHE_ENTRIES=256
QQBOT_TEXT_CHUNK_CHARACTERS=1800
QQBOT_MAX_REPLY_CHUNKS=4
QQBOT_OUTBOUND_TIMEOUT_MS=30000
QQBOT_PROBE_TIMEOUT_MS=120000
QQBOT_FULL_CHAIN_TIMEOUT_MS=300000
QQBOT_RECONNECT_PROBE_TIMEOUT_MS=300000

# Feishu / Lark enterprise self-built app
# Keep real credentials only in the untracked local .env.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_STARTUP_TIMEOUT_MS=30000
FEISHU_OUTBOUND_TIMEOUT_MS=30000
# Feishu text message content is limited by the platform; leave headroom below 150 KB.
FEISHU_TEXT_CHUNK_BYTES=120000
FEISHU_MAX_REPLY_CHUNKS=4
FEISHU_PROBE_TIMEOUT_MS=120000
FEISHU_VISIBLE_ACTIVITY_FALLBACK=true
FEISHU_VISIBLE_ACTIVITY_DELAY_MS=6000

# Codex app-server
CODEX_COMMAND=codex
CODEX_ARGS=app-server
# Leave blank to use the model configured by Codex itself.
CODEX_MODEL=
CODEX_CWD=.
# Persistent Codex thread/session state. The per-run bridge config is removed on shutdown.
CODEX_MANAGED_HOME=./data/codex-runtime
# Foreground Codex RPC/turn timeout. Provider stream idle is configured separately below.
CODEX_REQUEST_TIMEOUT_MS=120000

# DeepSeek provider
# Keep the real key only in .env or the process environment.
DEEPSEEK_API_KEY=
MIMO_API_KEY=
# Optional GitHub MCP credential. Keep only in the untracked local .env.
# Start with the minimum GitHub permissions needed for the read-only MCP queries you use.
GITHUB_PAT_TOKEN=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REQUEST_TIMEOUT_MS=300000
DEEPSEEK_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=high
# At most one retry, and only before the first provider stream chunk.
DEEPSEEK_PRESTREAM_MAX_ATTEMPTS=2
DEEPSEEK_RETRY_BASE_DELAY_MS=250
DEEPSEEK_RETRY_MAX_DELAY_MS=2000

# Local Responses bridge. The bridge refuses non-loopback bind addresses.
FLORAL_BRIDGE_HOST=127.0.0.1
FLORAL_BRIDGE_PORT=8790
# Generate a random local token; do not reuse the DeepSeek key.
FLORAL_BRIDGE_TOKEN=
FLORAL_BRIDGE_MAX_BODY_BYTES=4194304
FLORAL_BRIDGE_MAX_CONCURRENT_REQUESTS=4
FLORAL_BRIDGE_MAX_QUEUED_REQUESTS=8
FLORAL_BRIDGE_QUEUE_TIMEOUT_MS=15000

# Local SearXNG + pinned open-source MCP adapter.
# SearXNG stays on loopback; only the search tool is exposed to Codex.
SEARXNG_URL=http://127.0.0.1:8888
SEARXNG_REQUEST_TIMEOUT_MS=15000
SEARXNG_MCP_PACKAGE=mcp-searxng@1.0.3
SEARXNG_MCP_STARTUP_TIMEOUT_SEC=60
SEARXNG_MCP_TOOL_TIMEOUT_SEC=45

# Better Auth (used when the optional web admin surface is enabled)
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://127.0.0.1:8787

# Pairing bootstrap. Required for any real remote chat transport; use at least 12 random characters.
OWNER_PAIRING_CODE=

# Peekaboo readiness check. Codex itself reaches Peekaboo through MCP.
PEEKABOO_COMMAND=peekaboo
