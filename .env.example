NODE_ENV=development
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info
DATA_DIR=./data

# mock | real
QQ_MODE=mock
CODEX_MODE=mock
MACOS_MODE=mock
AUTH_MODE=local

# QQ Open Platform
QQBOT_APP_ID=
QQBOT_APP_SECRET=

# Codex app-server
CODEX_COMMAND=codex
CODEX_ARGS=app-server
# Leave blank to use the model configured by Codex itself.
CODEX_MODEL=
CODEX_CWD=.
CODEX_REQUEST_TIMEOUT_MS=120000

# DeepSeek provider
# Keep the real key only in .env or the process environment.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REQUEST_TIMEOUT_MS=120000
DEEPSEEK_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=high

# Local Responses bridge. The bridge refuses non-loopback bind addresses.
FLORAL_BRIDGE_HOST=127.0.0.1
FLORAL_BRIDGE_PORT=8790
# Generate a random local token; do not reuse the DeepSeek key.
FLORAL_BRIDGE_TOKEN=
FLORAL_BRIDGE_MAX_BODY_BYTES=4194304
FLORAL_BRIDGE_MAX_CONCURRENT_REQUESTS=4
FLORAL_BRIDGE_MAX_QUEUED_REQUESTS=8
FLORAL_BRIDGE_QUEUE_TIMEOUT_MS=15000

# Local SearXNG + pinned open-source MCP adapter.
# SearXNG stays on loopback; only the search tool is exposed to Codex.
SEARXNG_URL=http://127.0.0.1:8888
SEARXNG_REQUEST_TIMEOUT_MS=15000
SEARXNG_MCP_PACKAGE=mcp-searxng@1.0.3
SEARXNG_MCP_STARTUP_TIMEOUT_SEC=60
SEARXNG_MCP_TOOL_TIMEOUT_SEC=45

# Better Auth (used when the optional web admin surface is enabled)
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://127.0.0.1:8787

# Pairing bootstrap
OWNER_PAIRING_CODE=

# Peekaboo readiness check. Codex itself reaches Peekaboo through MCP.
PEEKABOO_COMMAND=peekaboo
